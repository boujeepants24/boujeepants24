# Copy to .env (never commit .env) and export before running, e.g. `set -a; . ./.env; set +a`

# Claude API credentials (or use `ant auth login` instead)
ANTHROPIC_API_KEY=

# What the knowledge base is about, in plain words. Used in the answer prompt.
DOMAINRAG_DOMAIN=the documents in this knowledge base

# Folder of source documents (.md .txt .html .pdf) and where the index is stored
DOMAINRAG_DOCS_DIR=knowledge
DOMAINRAG_DB=.domainrag/index.db

# Embeddings: "voyage" for real semantic search (needs VOYAGE_API_KEY), "hash" for offline testing
DOMAINRAG_EMBEDDER=hash
VOYAGE_API_KEY=
DOMAINRAG_VOYAGE_MODEL=voyage-3.5

# Answer model and effort (low | medium | high | xhigh | max)
DOMAINRAG_MODEL=claude-opus-5-5
DOMAINRAG_EFFORT=medium

# Retrieval tuning
DOMAINRAG_CHUNK_SIZE=1200
DOMAINRAG_CHUNK_OVERLAP=200
DOMAINRAG_TOP_K=6

# Allow the MCP `reindex` tool to re-read the knowledge folder (1 = on)
DOMAINRAG_ALLOW_REINDEX=0
