# Twilio account (Console → Account info). Never commit real values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The public https address Twilio calls. Must match the webhook URLs in the Twilio console exactly,
# because request signatures are computed over the full URL.
COMMS_PUBLIC_URL=https://comms.youragency.example

# Where the text-back log and the retry outbox are stored
COMMS_STATE_DIR=.commsgateway

# Local testing only: skips Twilio signature checks. Never set in production.
# COMMS_INSECURE_DEV=1
